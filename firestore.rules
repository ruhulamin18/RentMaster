rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email in [
               'amin2305101727@diu.edu.bd',
               'mdruhulaminridoy18@gmail.com'
             ];
    }

    function isOwner(userId) {
      return isAdmin() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid == request.auth.uid &&
             data.uid is string &&
             (!('houseName' in data) || (data.houseName is string && data.houseName.size() <= 300)) &&
             (!('houseNo' in data) || (data.houseNo is string && data.houseNo.size() <= 100)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 300)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 50)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('defaultGasBill' in data) || data.defaultGasBill is number) &&
             (!('defaultGarbageBill' in data) || data.defaultGarbageBill is number) &&
             (!('defaultWaterBill' in data) || data.defaultWaterBill is number);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);

      match /tenants/{tenantDocId} {
        allow list, get, create, update, delete: if isOwner(userId);
      }

      match /receipts/{receiptId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    match /{path=**}/receipts/{receiptId} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
