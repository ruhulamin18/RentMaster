             (!('name' in data) || (data.name is string && data.name.size() <= 300)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 50)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500));
    }

    function isValidTenant(data) {
      // id is a number (Date.now() or 1-8)
      return data.keys().hasAll(['id', 'name', 'ownerId']) &&
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 200 &&
             data.id is number;
    }

    function isValidReceipt(data) {
      return data.keys().hasAll(['tenantId', 'tenantName', 'totalBill', 'ownerId', 'createdAt']) &&
             data.ownerId == request.auth.uid &&
             (data.tenantId is string || data.tenantId is number) &&
             data.tenantName is string &&
             data.totalBill is number &&
             (data.createdAt is timestamp || data.createdAt.toMillis() > 0);
    }

    // --- Match Rules ---

